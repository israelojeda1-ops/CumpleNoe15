# Contenido completo (una sola linea) del JSON de la cuenta de servicio de Google
GOOGLE_SERVICE_ACCOUNT_KEY=

# ID de la carpeta de Google Drive donde se guardan las fotos
DRIVE_FOLDER_ID=

# PIN opcional para evitar que gente fuera del link suba fotos (dejar vacio para desactivar)
EVENT_PIN=

# Puerto (Render/Railway lo inyectan automaticamente, no hace falta tocarlo)
PORT=3000
